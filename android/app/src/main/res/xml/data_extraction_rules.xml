<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+: nothing from this app is included in cloud backups or
  device-to-device transfers. The sqflite database, shared preferences and
  the secure-storage keystore entries all stay on the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
